# Generate a secret: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HARNESS_API_KEY=replace-with-a-long-random-key
# Includes /v1. Host is resolved from inside the harness container.
GEN_URL=http://gpu-node:8000/v1
GEN_API_KEY=
HARNESS_CONFIG=profiles.yaml

# Empty = current lab service-key mode. JWT mode requires a mounted identity config.
# Characters of one vault note a read returns (default 48000; 4000-120000). Higher means fewer
# truncated notes but more context used, since tool loops resend earlier results each round.
HARNESS_VAULT_READ_CHARS=
HARNESS_IDENTITY_CONFIG=
# OIDC mode only: the Pocket ID client secret (leave empty for a public PKCE client).
HARNESS_OIDC_CLIENT_SECRET=

# Required when a profile enables mcp_vault. Trusted deployment-owned endpoint.
HARNESS_VAULT_MCP_URL=http://obsidian-mcp:8201/mcp

# Built-in /chat/ sign-in sessions (HttpOnly cookie). Idle minutes, then absolute hours.
HARNESS_SESSION_IDLE_MINUTES=720
HARNESS_SESSION_MAX_HOURS=168

# Python sandbox MCP server on the Hermes VM (ADR-003). Token must match SANDBOX_TOKEN there.
HARNESS_CODE_MCP_URL=http://<sandbox host>:8202/mcp
HARNESS_CODE_MCP_TOKEN=replace-with-the-sandbox-token

# Web search and page reading server on the Hermes VM. Token must match WEB_TOKEN there.
HARNESS_WEB_MCP_URL=http://<sandbox host>:8203/mcp
HARNESS_WEB_MCP_TOKEN=replace-with-the-web-token
# Knowledge base search on the RAG gateway. Token must match SEARCH_TOKEN there.
HARNESS_RAG_URL=http://<RAG gateway host>:8100
HARNESS_RAG_TOKEN=replace-with-the-gateway-search-token

# Document attachments in /chat/ (documents.py). PDF, Word, PowerPoint, Excel and HTML are
# converted by Docling Serve; Markdown and text work without it. Leave the URL empty to
# allow only Markdown and text. The key is Docling's X-Api-Key, if it requires one.
HARNESS_DOCLING_URL=
HARNESS_DOCLING_API_KEY=
HARNESS_DOCLING_TIMEOUT=600

# Every request tells the model today's date in this time zone (IANA name). Default UTC.
HARNESS_TIMEZONE=America/Chicago
