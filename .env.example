# Generate a secret: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HARNESS_API_KEY=replace-with-a-long-random-key
# Includes /v1. Host is resolved from inside the harness container.
GEN_URL=http://gpu-node:8000/v1
GEN_API_KEY=
HARNESS_CONFIG=profiles.yaml

# Empty = current lab service-key mode. JWT mode requires a mounted identity config.
HARNESS_IDENTITY_CONFIG=

# Required when a profile enables mcp_vault. Trusted deployment-owned endpoint.
HARNESS_VAULT_MCP_URL=http://obsidian-mcp:8201/mcp

# Built-in /chat/ sign-in sessions (HttpOnly cookie). Idle minutes, then absolute hours.
HARNESS_SESSION_IDLE_MINUTES=720
HARNESS_SESSION_MAX_HOURS=168

# Python sandbox MCP server on the tools VM (ADR-003). Token must match SANDBOX_TOKEN there.
HARNESS_CODE_MCP_URL=http://tools-vm.example.test:8202/mcp
HARNESS_CODE_MCP_TOKEN=replace-with-the-sandbox-token

# Web search and page reading server on the tools VM. Token must match WEB_TOKEN there.
HARNESS_WEB_MCP_URL=http://tools-vm.example.test:8203/mcp
HARNESS_WEB_MCP_TOKEN=replace-with-the-web-token
